{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "NexJob": "Information"
    }
  },
  "AllowedHosts": "*",
  "NexJob": {
    "Workers": 4,
    "PollingInterval": "00:00:00.200",
    "QueuePrefix": "reliability",
    "Queues": [ "default", "fragile", "held" ]
  }
}
