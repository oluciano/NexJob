{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "NexJob": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NexJobPostgresPrimary": "Host=localhost;Port=5432;Database=nexjob_sample;Username=postgres;Password=postgres",
    "NexJobPostgresReplica": "Host=localhost;Port=5432;Database=nexjob_sample;Username=postgres;Password=postgres",
    "NexJobRedis": "localhost:6379"
  },
  "NexJob": {
    "WorkerCount": 4,
    "PollIntervalSeconds": 1,
    "HeartbeatIntervalSeconds": 5
  }
}
