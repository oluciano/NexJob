{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "NexJob": "Information"
    }
  },
  "AllowedHosts": "*",
  "NexJob": {
    "Workers": 4,
    "PollingInterval": "00:00:01",
    "HeartbeatInterval": "00:00:05",
    "Triggers": {
      "AwsSqs": {
        "QueueUrl": "<your-sqs-queue-url>",
        "MaxMessages": 10,
        "WaitTimeSeconds": 20,
        "VisibilityTimeoutSeconds": 30
      },
      "AzureServiceBus": {
        "ConnectionString": "<your-service-bus-connection-string>",
        "QueueOrTopicName": "orders",
        "SubscriptionName": null,
        "MaxConcurrentMessages": 5
      },
      "GooglePubSub": {
        "ProjectId": "<your-gcp-project-id>",
        "SubscriptionId": "order-events-sub"
      },
      "Salesforce": {
        "Topic": "/data/AccountChangeEvent",
        "ClientId": "<your-consumer-key>",
        "ClientSecret": "<your-consumer-secret>",
        "AuthEndpoint": "https://login.salesforce.com/services/oauth2/token"
      },
      "SalesforceStreaming": {
        "Channel": "/data/ContactChangeEvent",
        "ClientId": "<your-consumer-key>",
        "ClientSecret": "<your-consumer-secret>",
        "Username": "<your-username>",
        "Password": "<your-password>"
      }
    }
  }
}
