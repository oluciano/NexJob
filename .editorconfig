root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:warning

# ── StyleCop: rules that conflict with this project's established conventions ──

# SA1309 — field names must not begin with underscore.
# Our convention is _camelCase for private fields (see .github/CONTRIBUTING.md).
dotnet_diagnostic.SA1309.severity = none
# SX1309 is the complementary rule that REQUIRES the underscore prefix (StyleCop.Analyzers.Unstable).
dotnet_diagnostic.SX1309.severity = none

# SA1633 — file must have a copyright/license header.
# We use MIT and list it in the NuGet metadata, not in every file.
dotnet_diagnostic.SA1633.severity = none

# SA1200 — using directives must be placed inside namespace.
# All our files use top-level usings (outside namespace), which is the modern C# standard.
dotnet_diagnostic.SA1200.severity = none

# SA1101 — prefix local calls with 'this'.
# Not part of our style guide; adds noise without value.
dotnet_diagnostic.SA1101.severity = none

# SA1600/SA1601/SA1602 — elements must be documented.
# Public members already have XML docs. Internal/private members are covered by
# GenerateDocumentationFile = true; we do not require triple-slash on every private member.
dotnet_diagnostic.SA1600.severity = warning
dotnet_diagnostic.SA1601.severity = warning
dotnet_diagnostic.SA1602.severity = warning

# SA1623 — property documentation must begin with "Gets" or "Gets or sets".
# Too prescriptive; existing docs are clear without the mandatory verb prefix.
dotnet_diagnostic.SA1623.severity = none


# SA1512 — single-line comment must not be followed by a blank line.
# Our section dividers (// ─── name ──────) are intentionally separated by a blank line.
dotnet_diagnostic.SA1512.severity = none

# SA1025 — code must not contain multiple whitespace characters in a row.
# Aligned assignments (var x   = 1; var foo = 2;) are used for readability in object initialisers.
dotnet_diagnostic.SA1025.severity = none


# SA1515 — single-line comment must be preceded by a blank line.
# Many inline comments in tight code blocks intentionally omit the blank line.
dotnet_diagnostic.SA1515.severity = none

# SA1615 — return value should be documented.
# Task/Task<T> return values on interface methods are self-evident; adding <returns> everywhere
# would be boilerplate noise without value.
dotnet_diagnostic.SA1615.severity = none

# SA1611 — parameter documentation missing.
# CancellationToken parameters are conventional and self-documenting.
dotnet_diagnostic.SA1611.severity = suggestion

# SA1642 — constructor summary must begin with "Initializes a new instance of the <see cref=…/> class."
# Our constructor docs are descriptive rather than following this formulaic wording.
dotnet_diagnostic.SA1642.severity = none

# SA1116/SA1117 — parameter placement rules (all on one line OR each on its own line).
# Our call sites occasionally mix styles for readability when arguments are short.
dotnet_diagnostic.SA1116.severity = none
dotnet_diagnostic.SA1117.severity = none

# SA1503/SA1519 — braces must not be omitted.
# Equivalent to csharp_prefer_braces already enforced via editorconfig; no need to duplicate.
dotnet_diagnostic.SA1503.severity = none
dotnet_diagnostic.SA1519.severity = none

# SA0001 — XML comment analysis disabled (fires when GenerateDocumentationFile=false).
dotnet_diagnostic.SA0001.severity = warning

# SA1516 — elements should be separated by blank line.
# Row-mapping and BSON-document classes have 20-40 compact properties; adding a blank
# line between each one doubles the file length without improving readability.
dotnet_diagnostic.SA1516.severity = suggestion

# S2094 — remove empty class/record.
# Empty input records (e.g. record QuickInput;) are legitimate test fixtures.
dotnet_diagnostic.S2094.severity = none


# SA1501/SA1107 — statement on single line / multiple statements on one line.
# Property accessors and short lambda bodies on a single line are valid style choices.
dotnet_diagnostic.SA1501.severity = none
dotnet_diagnostic.SA1107.severity = warning

# SA1009/SA1111 — closing parenthesis placement.
# Multi-line method calls with trailing-paren style conflict with fluent call alignment.
dotnet_diagnostic.SA1009.severity = warning
dotnet_diagnostic.SA1111.severity = warning

# SA1214 — readonly fields should appear before non-readonly fields.
# Fields are organised by purpose, not by mutability.
dotnet_diagnostic.SA1214.severity = none

# SA1134 — each attribute should be on its own line.
dotnet_diagnostic.SA1134.severity = warning

# SA1001 — commas should be followed by whitespace.
# False positives inside verbatim/interpolated HTML strings used in the dashboard renderer.
dotnet_diagnostic.SA1001.severity = warning

# SA1114 — parameter list should follow declaration.
# Related to SA1116/SA1117; same reason for suppression.
dotnet_diagnostic.SA1114.severity = none

# membership ordering rules (Wave 3)
dotnet_diagnostic.SA1201.severity = warning
dotnet_diagnostic.SA1202.severity = warning
dotnet_diagnostic.SA1204.severity = warning

# SA1504 (StyleCop 1.3) — all accessors single-line or multi-line.
# Off: it rejects the `get => field;` + `set { validation }` pair used by the options classes; the rewrite
# (`get { return field; }`) is noisier and fixes nothing.
dotnet_diagnostic.SA1504.severity = none

# SA1143 (StyleCop 1.3) — consistent layout of a conditional expression.
# Off: formatting only; the layouts in use follow line length and readability, and `dotnet format` does not fix it.
dotnet_diagnostic.SA1143.severity = none

# ── Microsoft.CodeAnalysis.NetAnalyzers (AnalysisMode=Recommended) ───────────

# CA1848 / CA1873 — use LoggerMessage / avoid evaluating log arguments when the level is off.
# Suggestion: ~200 call sites. Moving them to source-generated LoggerMessage is a separate piece of work,
# not part of the analyzer upgrade.
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion

# CA1859 — prefer concrete types for private members. Suggestion: the private helpers take the interface on
# purpose (the callers pass lists and arrays); a concrete type brings no measurable gain on these paths.
dotnet_diagnostic.CA1859.severity = suggestion

# CA1822 — member can be static. Suggestion: `SchemaMigrator.MigrateAsync` is public API (static would be a breaking
# change) and making the private `Apply*Async` helpers static trips SA1204 (static members first) and reorders ~600 lines.
dotnet_diagnostic.CA1822.severity = suggestion

# CA1716 / CA1711 / CA1068 — rename a public member, type or parameter (`Get`, `OnExecutingAsync(..., next)`,
# `JobExecutionDelegate`, a parameter order). Suggestion: each is a public API change, which needs a major version.
dotnet_diagnostic.CA1716.severity = suggestion
dotnet_diagnostic.CA1711.severity = suggestion
dotnet_diagnostic.CA1068.severity = suggestion

# ── Meziantou.Analyzer ────────────────────────────────────────────────────────

# MA0051 — Method is too long.
# Increased from 60 to 150 to accommodate complex dispatcher logic.
dotnet_diagnostic.MA0051.severity = suggestion

# MA0016 — Prefer using collection abstraction instead of implementation.
# In library options, List<T> is often preferred for easy direct manipulation by users.
dotnet_diagnostic.MA0016.severity = suggestion

# MA0048 — File name must match type name.
# Sometimes we group small related interfaces in one file.
dotnet_diagnostic.MA0048.severity = suggestion

# Suppress MA0011 (IFormatProvider) and documentation for Dashboard UI
[src/NexJob.Dashboard*/**/*.cs]
dotnet_diagnostic.MA0011.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1134.severity = none
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1202.severity = none
dotnet_diagnostic.SA1204.severity = none

# Suppress documentation rules for internal storage rows/documents
[src/NexJob.*/{JobRow,JobCatalogRow,RecurringJobRow,JobDocument,RecurringJobDocument,ServerDocument,ExecutionLogEntry,SchemaSQL,SchemaMigration,SqlServerSchemaSql}.cs]
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none

# Suppress MA0004 (ConfigureAwait) for Postgres due to type conflicts with await using and Dapper
[src/NexJob.Postgres/**/*.cs]
dotnet_diagnostic.MA0004.severity = none

# ── Test project overrides ────────────────────────────────────────────────────
# Tests have different style requirements: readability > formality.
# StyleCop and async result rules are suppressed; Sonar rules remain.
[tests/**/*.cs]
# CA1707: test names follow Method_Scenario_Expected.
dotnet_diagnostic.CA1707.severity = none
# CA2201: tests throw a plain Exception on purpose to prove how the code handles an arbitrary failure.
dotnet_diagnostic.CA2201.severity = none
# CA1001: xunit test classes release their fields in IAsyncLifetime / IDisposable hooks the analyzer does not follow.
dotnet_diagnostic.CA1001.severity = none
# CA2016 / CA2012 / CA1806: tests ignore a token, read a ValueTask or build an object without using it on purpose,
# to prove behaviour (a job that ignores cancellation, a constructor that throws).
dotnet_diagnostic.CA2016.severity = none
dotnet_diagnostic.CA2012.severity = none
dotnet_diagnostic.CA1806.severity = none
# CA2263 / CA1826 / CA1860 / CA1861 / CA1822 / CA1000: performance and API-shape hints that do not matter in test code.
dotnet_diagnostic.CA2263.severity = none
dotnet_diagnostic.CA1826.severity = none
dotnet_diagnostic.CA1860.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.SA0001.severity = none
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0006.severity = none
dotnet_diagnostic.MA0002.severity = none
dotnet_diagnostic.MA0011.severity = none
dotnet_diagnostic.MA0074.severity = none
dotnet_diagnostic.MA0134.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1202.severity = none
dotnet_diagnostic.SA1204.severity = none

[benchmarks/**/*.cs]
# CA1707: benchmark method names are the labels of the published tables.
dotnet_diagnostic.CA1707.severity = none
# CA1001: the BenchmarkDotNet lifecycle ([GlobalCleanup]) releases the fields, not IDisposable.
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.SA0001.severity = none
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0006.severity = none
dotnet_diagnostic.MA0002.severity = none
dotnet_diagnostic.MA0011.severity = none
dotnet_diagnostic.MA0134.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1202.severity = none
dotnet_diagnostic.SA1204.severity = none

# MA0004 (ConfigureAwait) off in the standalone host: it is an ASP.NET Core app, there is no synchronization context.
[src/NexJob.Dashboard.Standalone/{*,**/*}.cs]
dotnet_diagnostic.MA0004.severity = none
# S5332: the standalone dashboard listens on http by design; TLS is terminated by the reverse proxy (see the wiki).
dotnet_diagnostic.S5332.severity = none

# CA1001: the handlers dispose the field in StopAsync, which is the lifecycle of an IHostedService.
[src/NexJob.Trigger.*/*TriggerHandler.cs]
dotnet_diagnostic.CA1001.severity = none

# S8969: false positive on the explicit `RedisResult` to array/value conversions, whose operators return null for a nil reply.
[src/NexJob.Redis/RedisStorageProvider.cs]
dotnet_diagnostic.S8969.severity = none

# S1313: the "403::" / "401::" / "402::" strings are Salesforce error-code prefixes, not IP addresses.
[src/NexJob.Trigger.SalesforceStreaming/SalesforceBayeuxClient.cs]
dotnet_diagnostic.S1313.severity = none

# Samples are demos: documentation, member ordering and file layout rules would only add noise to the code a reader copies.
[samples/**/*.cs]
dotnet_diagnostic.SA0001.severity = none
dotnet_diagnostic.SA1402.severity = none
# CA1050 / CA1852 / CA1861 / CA1869: a sample keeps its job in the global namespace, unsealed, with inline arrays and
# options, for readability; none of it is library API.
dotnet_diagnostic.CA1050.severity = none
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1869.severity = none
# S2068: the "guest" credentials are the broker defaults of the docker-compose files the samples start.
dotnet_diagnostic.S2068.severity = none
# S2245: Random only picks demo payloads, nothing security-related.
dotnet_diagnostic.S2245.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0006.severity = none
dotnet_diagnostic.MA0002.severity = none
dotnet_diagnostic.MA0011.severity = none
dotnet_diagnostic.MA0074.severity = none
dotnet_diagnostic.MA0134.severity = none
dotnet_diagnostic.MA0047.severity = none
dotnet_diagnostic.RS0030.severity = none
dotnet_diagnostic.SCS0005.severity = none
dotnet_diagnostic.SA1200.severity = none
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1202.severity = none
dotnet_diagnostic.SA1204.severity = none
dotnet_diagnostic.SA1210.severity = none
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1503.severity = none
dotnet_diagnostic.SA1512.severity = none
dotnet_diagnostic.SA1515.severity = none
dotnet_diagnostic.SA1516.severity = none
dotnet_diagnostic.SA1519.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1611.severity = suggestion
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1623.severity = none
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1642.severity = none

# ── Sample project overrides ──────────────────────────────────────────────────
# Program.cs uses top-level statements; types at the end are intentionally in
# the global namespace and have no explicit access modifier by design.
# Job files co-locate the input record with the job class for readability in demos.
[samples/**/*.cs]
dotnet_diagnostic.S3903.severity = none
dotnet_diagnostic.SA1400.severity = none
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none

[*.{json,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
